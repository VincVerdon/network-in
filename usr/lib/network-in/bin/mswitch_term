TMP=/tmp/network-in
VDE_PATH=/usr/lib/network-in/vde4networkin

ID=$1
SCR=$2
WID=$3
FONT=$4

DISPLAY=$SCR st -f "$FONT" -w $WID -e $VDE_PATH/vdeterm $TMP/terminal/$ID
