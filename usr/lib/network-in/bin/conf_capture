#!/bin/bash
####################################################################
#Programme écrit par V. Verdon
#Network-in est un simulateur de réseau
#placé sous licence GNU GPL (consulter le fichier joint intitulé "licence.txt")
#version 20260331
####################################################################
TMP=/tmp/network-in
VDE_PATH=/usr/lib/network-in/vde4networkin
ACTION=$1
TAP=netkin_capture


#besoin de bridge-utils pour faire fonctionner le mode promiscuite

if [ "$ACTION" = "start" ]
then

		$VDE_PATH/vde_switch -d --nostdin -hub --tap $TAP -l /dev/null -p $TMP/switch_capture_PID -s $TMP/vde/capture -m 666
		/sbin/ip link set $TAP promisc on
		/sbin/ip link set $TAP up
		#On empêche l'émission de paquets depuis la machine hôte sur cette interface
		iptables -D OUTPUT -o $TAP -j DROP 2> /dev/null
		ip6tables -D OUTPUT -o $TAP -j DROP 2> /dev/null
		iptables -A OUTPUT -o $TAP -j DROP
		ip6tables -A OUTPUT -o $TAP -j DROP
		

else
		
		iptables -D OUTPUT -o $TAP -j DROP
		ip6tables -D OUTPUT -o $TAP -j DROP
	    /sbin/ip link set $TAP down
		/sbin/ip a flush dev $TAP
		#/sbin/ip link delete $TAP
		#déparamétrage et suppression du switch
    	/bin/kill $(cat $TMP/switch_capture_PID)
		
fi


