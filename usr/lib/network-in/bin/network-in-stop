#!/bin/sh
####################################################################
#Programme écrit par V. Verdon
#Network-in est un simulateur de réseau
#placé sous licence GNU GPL (consulter le fichier joint intitulé "licence.txt")
#version 20250516
####################################################################
TMP=/tmp/network-in
N_SCREEN_0=$(sed -r 's/:([0-9]).*/\1/' <<< $DISPLAY)
X_PORT_0=$((6000 + $N_SCREEN_0))
N_SCREEN=$(grep -E  '^[^#]*set screen' /etc/network-in.cfg | grep -o '[0-9]')
X_PORT=$((6000 + $N_SCREEN))

#Effacement des règles de parefeu
/sbin/iptables -D INPUT -i networkin_com -p tcp --dport $X_PORT -j ACCEPT
/sbin/iptables -D INPUT -i networkin_com -p tcp --dport $X_PORT_0 -j ACCEPT
/sbin/iptables -D INPUT -i networkin_com -j DROP
/sbin/iptables -D FORWARD -i networkin_com -j DROP

#Arrêt des switchs
#kill $(pidof vde_switch)
killall vde_switch

#Désactivation des interfaces
/sbin/ip link set networkin_com down
/sbin/ip link delete networkin_com

#Suppression du répertoire temporaire
rm -rf $TMP

echo ARRET NETWORK-IN
