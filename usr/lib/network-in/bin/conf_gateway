#!/bin/sh
####################################################################
#Programme écrit par V. Verdon
#Network-in est un simulateur de réseau
#placé sous licence GNU GPL (consulter le fichier joint intitulé "licence.txt")
#version 20240923
####################################################################

IP=$1
MASK=$2
ACTION=$3
TMP=/tmp/network-in

if [ "$ACTION" = "start" ]
then

    /usr/sbin/vde_tunctl -t networkin_out
    /usr/bin/vde_switch -d -nostdin -tap networkin_out -s $TMP/vde/switch_gateway -M /tmp/pass -m 666
    #/usr/bin/slirpvde -d -nostdin --host $IP/$MASK -s $TMP/vde/switch_gateway 
    #/usr/bin/vde_switch -d -nostdin -tap wlp0s20f3 -s $TMP/vde/switch_gateway -m 666
	
    #paramétrage de l'interface
    /sbin/ip a add $IP/$MASK dev networkin_out
    #/sbin/ip a add $IP/$MASK dev networkin_out noprefixroute
    /sbin/ip link set networkin_out up
    #paramétrage du parefeu
    /sbin/iptables -t nat -A POSTROUTING -s $IP/$MASK -j MASQUERADE
    
else

    #déparamétrage du parefeu
	/sbin/iptables -t nat -D POSTROUTING -s $IP/$MASK -j MASQUERADE
    #déparamétrage et suppression du switch et de l'interface
    PID=$(lsof -Fp $TMP/vde/switch_gateway/ctl)
    PID=${PID##p}
    /bin/kill $PID
    /sbin/ip link set networkin_out down
    /sbin/ip a flush dev networkin_out
    /sbin/ip link delete networkin_out
    
fi
