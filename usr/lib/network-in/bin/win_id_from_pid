#!/bin/bash
####################################################################
#Programme écrit par V. Verdon
#Network-in est un simulateur de réseau
#placé sous licence GNU GPL (consulter le fichier joint intitulé "licence.txt")
#version 20260407
####################################################################
TMP=/tmp/network-in
PID=$1		#WIN is the window identifier
DISP=$2		#DIS is virtual X screen to use

if [ -n "$DISP" ]
then
	RES=$(DISPLAY=$DISP wmctrl -l -p)
else
	RES=$(wmctrl -l -p)
fi

while read WID N PS H T
do
	if [ $PID -eq $PS ]
	then
		echo $WID
	fi
done <<< $RES