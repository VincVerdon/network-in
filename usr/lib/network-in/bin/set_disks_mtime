DIR=$1

echo Mtime disk images configuration in $DIR : 

#LIST=$(ls ${DIR}/*.img 2> /dev/null)
LIST=$(find ${DIR} -name '*.img' 2> /dev/null)
for FIMG in $LIST
do
	NAME=$(basename $FIMG .img)
	DIRTIME=$(dirname $FIMG)
	FTIME="${DIRTIME}/${NAME}.time"
	if [ -f $FTIME ]
	then
		TIME=$(head -n 1 $FTIME)
		DTIME=$(stat -c %Y $FIMG)
		if [ "$TIME" != "$DTIME" ]
		then
			TIME=$(date --date="@$TIME" +'%FT%T')
			touch -m -d $TIME $FIMG
			echo "Mtime modified for disk image $FIMG"
		fi
	else
		echo "No time file found for disk image $FIMG. Can be a problem when a simulation file is loaded"
	fi 
done

echo Done
