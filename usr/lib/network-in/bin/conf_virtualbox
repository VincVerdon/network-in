#!/bin/bash
####################################################################
#Programme écrit par V. Verdon
#Network-in est un simulateur de réseau
#placé sous licence GNU GPL (consulter le fichier joint intitulé "licence.txt")
#version 20260328
####################################################################
TMP=/tmp/network-in
VDE_PATH=/usr/lib/network-in/vde4networkin
ID=$1
VM=$2
ACTION=$3
NIC=$4

echo $DISPLAY

case "$ACTION" in
	start)
		
		#Configuration interface sur un switch VDE
		$VDE_PATH/vde_switch -d --nostdin -hub -n 2 -p $TMP/vbox_$ID_PID -l /dev/null -s $TMP/vde/$ID &>/dev/null
		vboxmanage modifyvm $VM --nic${NIC} generic
		vboxmanage modifyvm $VM --nicgenericdrv${NIC} VDE
		vboxmanage modifyvm $VM --nicproperty${NIC} network=$TMP/vde/$ID
		#Démarrage VM
		#DISPLAY=:0 vboxmanage startvm $VM --type separate
		vboxmanage startvm $VM --type separate
		;;
	    
	stop) 
		
		#Arrêt VM
		vboxmanage controlvm $VM acpipowerbutton
		#On supprime le switch utilisé
	    /bin/kill $(cat $TMP/vbox_$ID_PID)
	    ;;
	
	force)
	
		#Arrêt VM
		vboxmanage controlvm $VM poweroff
		#On supprime le switch utilisé
	    /bin/kill $($TMP/vbox_$ID_PID)
	    ;;
		
esac
