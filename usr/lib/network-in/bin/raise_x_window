TMP=/tmp/network-in
WIN=$1		#WIN is the window identifier
DISP=$2		#DIS is virtual X screen to use

if [ -n "$DISP" ]
then
	DISPLAY=$DISP wmctrl -i -a $WIN
else
	wmctrl -i -a $WIN
fi